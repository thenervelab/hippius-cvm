# hippius-miner-agent configuration — example.
#
# Copy to /etc/hippius-miner/config.toml on the miner host and edit.
# This file holds NO secrets: only paths and endpoints. The mTLS
# material it references is delivered out-of-band by the operator
# (never via Vault — the miner is untrusted); the identity key is
# self-generated by `hippius-miner-agent init-identity`.

[miner]
# Operator-assigned stable identifier for this miner host. REPLACE —
# must be unique across the operator's fleet.
miner_id = "<MINER_ID>"

[edge]
# Edge gateway endpoint. Reached over the NetBird mesh; HTTPS only.
endpoint = "https://edge.hippius.network:443"
# mTLS client certificate + key for the Edge connection. Delivered
# out-of-band by the operator (SSH copy) — see the README. Never Vault.
client_cert = "/var/lib/hippius-miner/edge-mtls.crt"
client_key = "/var/lib/hippius-miner/edge-mtls.key"
# CA certificate that signs the Edge server certificate.
ca_cert = "/var/lib/hippius-miner/edge-ca.crt"
# The fleet's order-signing PUBLIC key, 64 hex. REQUIRED — the agent
# `verify_strict`s EVERY lifecycle order against it, so a wrong value
# means every order is rejected and a missing one means the agent
# refuses to start. Ask the fleet you are joining; if you run your own,
# it is the public half of the Edge's order-signing key.
order_signing_pubkey = "<FLEET_ORDER_SIGNING_PUBKEY_64_HEX>"

[identity]
# The miner's self-generated Ed25519 identity. The secret key is
# written 0400 and never leaves this host; the public sidecar is 0444.
key_path = "/var/lib/hippius-miner/identity.key"
pub_path = "/var/lib/hippius-miner/identity.pub"

[image]
# Content-addressed local cache for fetched UKI images.
cache_dir = "/var/lib/hippius-miner/images"
# Directory verified images are installed into.
staging_dir = "/var/lib/hippius-miner/staging"
# Hippius S3 endpoint + bucket for UKI image fetch. The §22 root
# public key the provenance is verified against is compiled into the
# binary (via the miner-uki-fetch library) — it is never configured.
s3_endpoint = "https://s3.hippius.com"
s3_bucket = "hippius-compute-images"

[orders]
# Where the agent listens for signed lifecycle orders from the Edge.
# REQUIRED. Bind to THIS host's mesh address, not 0.0.0.0: the order
# server must not be reachable from outside the overlay. Port 9700 is
# the fleet default.
bind_addr = "<THIS_MINER_MESH_IP>:9700"

[host]
# The CPU / memory / disk capacity this host COMMITS to tenant CVMs.
# Operator-declared, not auto-detected: deliberately reserve headroom for
# the host OS + the agent itself. The lifecycle refuses any launch that
# would overcommit a budget.
cvm_cpu_budget = 8
cvm_memory_mb_budget = 16384
# Total GiB of tenant DATA disk the host commits to. Set it to the real
# free capacity of `[storage].data_disk_root` (e.g. the NVMe RAID below).
# The agent RESERVES against it so concurrent launches can't over-commit
# the backing store, and vali's scheduler uses it for disk-aware
# placement. OPTIONAL — omit (or 0) to DISABLE the disk reservation; the
# cpu/mem budgets and the per-create statvfs backstop still apply.
cvm_disk_gb_budget = 0

# [storage] — OPTIONAL. Where per-VM disks physically live on the host.
# Omit this table to keep the historical /var/lib/hippius-miner defaults.
# Point `data_disk_root` at a dedicated mount (e.g. an NVMe RAID) to keep
# tenant `/data` off the OS root — the data disk carries the heaviest I/O
# (the first-boot dm-integrity wipe). Security is location-independent:
# the disk is luksFormat'd with a guest-held key inside the SNP boundary,
# so the host only ever sees ciphertext. See README "Storage layout".
# [storage]
# data_disk_root = "/mnt/hippius-data"   # → <root>/data/<vm_id>.img
# state_disk_root = "/var/lib/hippius-miner"  # → <root>/state/<vm_id>.raw
