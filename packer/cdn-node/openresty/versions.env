# Pinned sources for the cdn-node OpenResty build (CDN plan I2).
#
# Every URL is a VERSIONED release artefact (never a `latest` link), and
# every tarball is checked against its SHA-256 before it is unpacked.
# The hashes were taken from tarballs whose upstream signatures verified
# (OpenResty: Yichun Zhang; OpenSSL: OpenSSL release key; PCRE2: Nicholas
# Wilson; zlib: Mark Adler). Bumping a version means re-verifying the
# signature and replacing both lines.
#
# Brotli is NOT built: the beta is gzip-only (decision G.8). Adding it
# means pinning ngx_brotli + its brotli submodule here and flipping
# BROTLI_AVAILABLE in binaries/cdn-agent/src/config.rs.

OPENRESTY_VERSION=1.27.1.2
OPENRESTY_URL=https://openresty.org/download/openresty-1.27.1.2.tar.gz
OPENRESTY_SHA256=74f076f7e364b2a99a6c5f9bb531c27610c78985abe956b442b192a2295f7548

OPENSSL_VERSION=3.4.3
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.4.3/openssl-3.4.3.tar.gz
OPENSSL_SHA256=fa727ed1399a64e754030a033435003991aee36bda9a5b080995cb2ac5cf7f37

PCRE2_VERSION=10.45
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.gz
PCRE2_SHA256=0e138387df7835d7403b8351e2226c1377da804e0737db0e071b48f07c9d12ee

ZLIB_VERSION=1.3.1
# The upstream GitHub release (same bytes as zlib.net/fossils, whose CDN
# intermittently served something else and failed the hash check).
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23

# Fixed timestamp for every file in the output tarball.
SOURCE_DATE_EPOCH=1767225600
