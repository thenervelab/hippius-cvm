# Hippius guest components release. Read by hippius-keepalive.service.
# HIPPIUS_KEEPALIVE_INTERVAL_SECS MUST stay <= vali's
# uptimeLiveness.coverageSeconds (900): one attestation vouches BACKWARD
# for that span only. The measured cmdline (hippius.keepalive_interval_secs)
# overrides it.
HIPPIUS_KEEPALIVE_INTERVAL_SECS=300
HIPPIUS_KEEPALIVE_RELAY_PORT=5000
# Attest the release and its agents' health (live-attestation schema v4).
# Matches release.conf's health_mask (the builder refuses a mismatch).
HIPPIUS_KEEPALIVE_ATTEST_COMPONENTS=1
