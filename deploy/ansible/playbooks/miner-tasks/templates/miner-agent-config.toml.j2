# hippius-miner-agent configuration — RENDERED BY ANSIBLE.
# Source: deploy/ansible/playbooks/miner-tasks/templates/miner-agent-config.toml.j2
# Do not hand-edit on the miner; change the template + re-run
# 06-miner-bootstrap.yml.
#
# Miners are UNTRUSTED: this file holds NO secrets — only paths,
# endpoints, and the Edge's PUBLIC order-signing key. The mTLS material
# is operator-provisioned out-of-band; the identity key is
# self-generated by `hippius-miner-agent init-identity`.

[miner]
miner_id = "{{ inventory_hostname }}"

[edge]
# host:port from group_vars/miner_nodes.yml; the miner-agent requires
# an https:// endpoint.
endpoint = "https://{{ network.edge_endpoint }}"
{% if miner_edge_auth | default('onchain') == 'ca' %}
# LEGACY operator-CA mTLS: the operator hand-issues this miner a client
# cert (see miner-tasks/mtls-cert-mount.yml). Permissioned — the Edge
# admits only a cert chaining to the operator CA.
client_cert = "{{ mtls.cert_dir }}/client.crt"
client_key = "{{ mtls.cert_dir }}/client.key"
{% else %}
# PERMISSIONLESS on-chain auth (docs/design/permissionless-miner-auth.md):
# no operator client cert. The agent mints a SELF-SIGNED client cert
# from its own identity key at boot; the Edge (EDGE_MINER_AUTH=onchain)
# admits it iff this node_id is registered + Active on
# `pallet-compute-scoring` (§23). Register with `deploy/register-miner/`.
# `client_cert` / `client_key` are intentionally OMITTED → self-sign.
{% endif %}
# CA that signs the Edge's SERVER cert — the agent verifies the Edge
# with it in BOTH auth modes (only the CLIENT side flips). Provisioned
# by the playbook (it is the Edge's public server CA, not a secret).
ca_cert = "{{ mtls.cert_dir }}/ca.crt"
# The Edge gateway's order-signing Ed25519 PUBLIC key (64 hex chars).
# Every lifecycle order (MA-5) is `verify_strict`-checked against it.
# NOT a secret — rendered from `edge_order_signing_pubkey` in
# group_vars/miner_nodes.yml. Operator rotates by re-running this
# playbook + reloading the agent (atomic with the Vault seed flip
# on the Edge side; see `binaries/edge-gateway/README.md`
# "Order signing").
order_signing_pubkey = "{{ edge_order_signing_pubkey }}"

[identity]
# Self-generated on the miner — never imported.
key_path = "{{ miner_agent.state_dir }}/identity.key"
pub_path = "{{ miner_agent.state_dir }}/identity.pub"

[image]
cache_dir = "{{ miner_agent.state_dir }}/images"
staging_dir = "{{ miner_agent.state_dir }}/staging"
# Hippius S3 for UKI image fetch. The §22 root public key is compiled
# into the binary (miner-uki-fetch) — never configured here.
s3_endpoint = "{{ image.s3_endpoint }}"
s3_bucket = "{{ image.s3_bucket }}"

[orders]
# The lifecycle-order HTTP server (MA-5) binds the NetBird mesh
# interface ONLY — the miner-agent rejects any bind_addr outside the
# NetBird CGNAT range (100.64.0.0/10). `miner_netbird_ip` is the
# miner's own NetBird address, auto-discovered at mesh join by
# `netbird-agent.yml` (falls back to the `orders_bind_ip` placeholder
# only if discovery failed); the port is `orders.port` from group_vars.
bind_addr = "{{ miner_netbird_ip | default(orders_bind_ip) }}:{{ orders.port }}"

[host]
# CPU / RAM the host allots to tenant CVMs — a deliberate RESERVATION
# (headroom is kept for the host OS + miner-agent), not the full
# machine. The lifecycle refuses any launch that would overcommit it.
cvm_cpu_budget = {{ host_cvm.cpu_budget }}
cvm_memory_mb_budget = {{ host_cvm.memory_mb_budget }}

{% if miner_kbs_endpoint is defined %}
[kbs]
# KBS-over-vsock proxy: tenant guests relay their §21 release exchange
# through the agent over AF_VSOCK (the guest needs no route/DNS/mesh).
# The agent reaches this KBS base over ITS OWN network. Only the §21
# release paths are forwarded (not a general SSRF carrier).
endpoint = "{{ miner_kbs_endpoint }}"
{% if miner_kbs_ca_cert_file | default('') %}
# CA (or pinned self-signed leaf) the agent trusts when dialling the KBS,
# ON TOP of the webpki roots. Required whenever the KBS serves a private
# certificate — which it does by default, being an internal service reached
# over the mesh rather than a public ACME endpoint.
#
# Omit this against a KBS with a publicly-trusted certificate. Get it wrong
# and the failure is silent and late: the agent's TLS handshake fails, the
# vsock relay answers `refused kbs-transport`, and the guest — which never
# receives its KEK — sits in its initramfs burning a core while libvirt
# reports the domain as running. Nothing in the launch says "certificate".
ca_cert = "{{ miner_kbs_ca_cert_file }}"
{% endif %}
{% endif %}
{% if miner_vali_lifecycle_url is defined %}
[lifecycle]
# §24/§25 guest stopped-ack vali ingress. The confidential guest has NO
# IP route to vali, so its signed `stopped{}` ack rides the SAME vsock
# proxy ([kbs] above) and the agent forwards the OPAQUE bytes here (plus
# the `?vm_id=&generation=` query) to vali's `/v1/lifecycle/stopped`.
# The agent never decodes/forges the ack — vali's verifier is the §25
# split-brain fence. This points at the EDGE stopped-ack relay (vali has
# no public ingress): the Edge :8446 listener forwards the body to vali.
# The Edge serves its OWN server cert (private hippius-compute CA), and
# its cert's SAN is the Edge LoadBalancer IP, so `vali_url` is that IP
# directly — no public DNS / public cert needed. Requires [kbs] set.
vali_url = "{{ miner_vali_lifecycle_url }}"
# CA that signs the Edge's server cert — the SAME CA used for the [edge]
# server-auth above. The forward client adds it to its trust roots so
# the private-CA Edge cert validates (kept ON TOP of the webpki roots).
ca_cert = "{{ mtls.cert_dir }}/ca.crt"
{% endif %}

[storage]
# Where per-VM disks live. The agent appends its own subdirectory, so a
# root of `/srv/fast` gives `/srv/fast/data/<vm>.img`.
#
# `data_disk_root` carries BOTH heavy artefacts — the tenant data disk
# (`/dev/vde`) and the golden overlay — and the data disk takes the
# heaviest I/O of a VM's life: the first-boot dm-integrity wipe writes the
# whole volume. Point this at your fastest dedicated storage; leaving it on
# the system disk is the single most common way to make a miner look slow.
#
# Security does NOT depend on the location: both files are formatted inside
# the SNP boundary with a key the guest holds and the host never sees, so
# the miner only ever has ciphertext, wherever the file sits.
data_disk_root = "{{ miner_data_disk_root }}"
# The 1 MiB anti-rollback counter. Tiny, rarely worth moving — but it is
# the file whose LOSS permanently bricks a VM (no counter ⇒ the KBS
# refuses the KEK), so put it somewhere durable rather than somewhere fast.
state_disk_root = "{{ miner_state_disk_root }}"
