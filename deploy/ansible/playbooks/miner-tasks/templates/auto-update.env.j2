# Managed by Ansible (miner-tasks/miner-agent-install.yml). Do not edit by hand.
# Environment for /usr/local/bin/hippius-miner-update (sourced by the script).
# See miner-tasks/AUTO_UPDATE.md.

# Kill switch (the /var/lib/hippius-miner/.no-auto-update file does the
# same). Rendered from miner_auto_update_enabled.
AUTO_UPDATE_DISABLED={{ (not (miner_auto_update_enabled | bool)) | lower }}

# GitHub Releases of this repository; the attestation must come from its
# .github/workflows/miner-agent-release.yml at the tag being installed.
RELEASE_REPO={{ miner_auto_update_release_repo }}

# Hours a release must have been public before this host installs it.
MIN_RELEASE_AGE_H={{ miner_auto_update_min_release_age_h | int }}

# Seconds the relaunched agent has to deliver a heartbeat before rollback.
HEALTH_TIMEOUT_S={{ miner_auto_update_health_timeout_s | int }}

COSIGN_BIN={{ miner_cosign.path }}
MINER_BINARY={{ miner_agent.install_path }}
MINER_SERVICE={{ miner_agent.systemd_unit_name }}
MINER_STATE_DIR={{ miner_agent.state_dir }}
MINER_CONFIG={{ miner_agent.config_path }}
