# Managed by Ansible (miner-tasks/miner-agent-install.yml). Do not edit by hand.
# Environment for /usr/local/bin/hippius-miner-update (sourced by the script).

# Base S3 prefix holding the manifest + per-tag binaries. The updater fetches
# ${S3_BASE}/latest.json and (by default) ${S3_BASE}/<tag>/hippius-miner-agent.
# Public-read; no creds needed (the binary is a client binary, not a secret —
# integrity comes from the manifest sha256 over HTTPS, + the optional sig).
S3_BASE={{ miner_auto_update_s3_base }}

{% if miner_auto_update_pubkey | default('') | length > 0 %}
# Pinned operator Ed25519 public key (64-hex or a PEM path). When set, the
# updater REQUIRES the manifest to carry a valid `sig` over the sha256 hex.
UPDATE_PUBKEY={{ miner_auto_update_pubkey }}
{% else %}
# UPDATE_PUBKEY unset — signature check skipped (sha256-over-HTTPS baseline).
{% endif %}

# Belt-and-suspenders kill switch (the /var/lib/hippius-miner/.no-auto-update
# sentinel file does the same). Flip to true to freeze a miner on its current
# binary without removing the timer.
AUTO_UPDATE_DISABLED={{ (not (miner_auto_update_enabled | default(false) | bool)) | lower }}
