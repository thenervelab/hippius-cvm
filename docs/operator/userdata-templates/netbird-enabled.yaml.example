#cloud-config
# NetBird-enabled tenant userdata template (#306).
#
# Pair this with `vali_create_vm --enable-netbird` — vali mints a
# one-off NetBird setup-key via the management API and substitutes the
# literal `{{NETBIRD_SETUP_KEY}}` placeholder below before the userdata
# is stashed in Vault. The substitution happens in-memory; the
# plaintext key never touches durable storage on the vali side. The
# userdata then rides the §21 KBS-released envelope to a tmpfs at
# `/run/cloud-init/seed/` on the booted tenant (per #264) — also never
# on disk.
#
# Replace the placeholders below as needed. Do NOT remove the
# `{{NETBIRD_SETUP_KEY}}` token — `vali_create_vm` will refuse the
# stage if it is missing while `--enable-netbird` is on.

# Key-only SSH. `true` made cloud-init write `PasswordAuthentication yes` to
# /etc/ssh/sshd_config.d/50-cloud-init.conf, which sshd reads before the
# image's own `no` (the first value wins). The golden images also ship a
# 00-hippius-harden.conf that wins over it, but the seed must not ask.
ssh_pwauth: false
# `default` resolves to the cloud image's OWN built-in admin user, as
# declared in that image's `/etc/cloud/cloud.cfg` `system_info:
# default_user`. Do NOT hardcode a distro-specific name here: a literal
# `name: ubuntu` creates an `ubuntu` user on EVERY image — including
# CentOS / RHEL / Fedora — leaving the distro's real admin account
# (`cloud-user` on CentOS Stream / RHEL, `debian` on Debian, `fedora`
# on Fedora, `ubuntu` on Ubuntu) un-keyed and the operator locked out.
# Using `default` makes the same template correct on every supported OS.
users:
  - default

# Operator SSH public key(s), applied to the distro default user above
# (top-level `ssh_authorized_keys` keys the default user regardless of
# its distro-specific name). Replace with one or more real keys before
# launch — an empty list with no password leaves the VM unreachable.
ssh_authorized_keys: []

# DEV-SMOKE ONLY: uncomment to give the default user a password (sudo).
# `default` is accepted by chpasswd and maps to the distro admin user
# resolved above. SSH stays key-only either way: `ssh_pwauth` is false and
# the images ship /etc/ssh/sshd_config.d/00-hippius-harden.conf.
# chpasswd:
#   expire: false
#   users:
#     - name: default
#       password: hippius
#       type: text

write_files:
  # The setup-key file `netbird up` reads below. `0600` + root:root —
  # netbird runs as root inside the tenant. NOT tmpfs: this path is on the
  # guest's root filesystem; the purge at the end of runcmd removes it.
  - path: /var/lib/cloud/seed/nocloud/netbird-setup-key
    permissions: '0600'
    owner: root:root
    content: |
      {{NETBIRD_SETUP_KEY}}

runcmd:
  # The netbird agent is PRE-INSTALLED in the tenant image at bake time
  # (scripts/tenant-image-bake.sh, pinned version) — first boot only
  # ENROLS, no apt/curl at boot. Pre-installing is deliberate: the
  # upstream first-boot installer runs
  # `apt-get install -y ca-certificates curl gnupg`, which upgrades the
  # curl/ca-certificates the bake holds (apt-mark hold) and aborts with
  # `E: Held packages were changed …`, so netbird never installed and
  # the guest never joined the overlay (prodcheck-1/-2: setup-key
  # used=0). Do NOT re-add a `curl … install.sh | sh` line here.
  #
  # Enrol with the per-tenant key. The setup-key file is single-use;
  # `netbird up` consumes it and the daemon supervises the mesh
  # connection thereafter (the install script puts a systemd unit in
  # place with `Restart=on-failure`).
  #
  # `--hostname={{NETBIRD_HOSTNAME}}` is expanded by `vali_create_vm`
  # from `--netbird-hostname-template` (default `hippius-tenant-{vm_id}`)
  # so the joined peer's FQDN is `<template>.hippius.decentralized`.
  # Per-vm-id stable FQDNs let operators ssh into a specific tenant by
  # name without an IP lookup (#309).
  #
  # Customer-held keys (key_mode split / customer): vali inserts three
  # flags right after `up` that stop the NetBird management plane from
  # steering the guest's DNS or routes (`customer_keys.NETBIRD_UP_HARDENING`),
  # and refuses such a launch when it finds no enrolment to harden. Supported
  # shapes: this unquoted flow list, a block list (`- netbird` / `- up`), or
  # a shell string containing `netbird up`. A QUOTED flow list
  # (`[ "netbird", "up" ]`) is not recognised and refuses the launch.
  - [ netbird, up,
      --setup-key-file=/var/lib/cloud/seed/nocloud/netbird-setup-key,
      --management-url=https://vpn.hippius.network,
      --hostname={{NETBIRD_HOSTNAME}},
      --no-browser ]
  # Purge the setup-key file and cloud-init's copies of the whole userdata
  # (the setup key in it): the released seed and the combined config under
  # /run, and user-data.txt(.i) / cloud-config.txt / the pickled datasource
  # in every instance dir (one per boot). Queued behind cloud-final.service,
  # which runs this very runcmd: cloud-init writes its state until its last
  # stage ends. `--no-block` is load-bearing — waiting for the unit from
  # inside cloud-final would deadlock. The KBS releases the userdata again
  # on every boot, so nothing cloud-init needs is lost. Keep it LAST, and on
  # one line: the backend's HA userdata has ~4 KB of headroom to the cap
  # (hippius-backend compute/userdata_netbird.yaml carries the same line).
  - [ systemd-run, --no-block, -pAfter=cloud-final.service, sh, -c, "cd /var/lib/cloud/instances && rm -f */user-data.txt* */cloud-config.txt */obj.pkl ../seed/nocloud/netbird-setup-key /run/cloud-init/seed/user-data /run/cloud-init/combined-cloud-config.json" ]
